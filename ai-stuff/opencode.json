{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "Svelte": {
                "type": "remote",
                "url": "https://mcp.svelte.dev/mcp",
                "enabled": true
            },
            "playwright": {
                "type": "local",
                "command": ["bunx", "@playwright/mcp@latest"],
                "enabled": true
            },
            "Supabase": {
                "type": "remote",
                "url": "https://mcp.supabase.com/mcp",
                "enabled": true
            },
            "graphify": {
                "type": "remote",
                "url": "https://api.graphify.com/mcp",
                "enabled": true
            }
        }
    }
}
